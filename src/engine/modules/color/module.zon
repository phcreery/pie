.{
    .name = "color",
    .type = .compute,
    .params = .{
        // .{ .name = "wb_temp", .len = 1, .typ = .f32 },
        // .{ .name = "wb_tint", .len = 1, .typ = .f32 },
        .{ .name = "wb_mode", .len = 1, .typ = .enum_u32, .enum_names = .{ "cam_mul", "cat", "vkdt" } },
        .{ .name = "wb_coeff", .len = 3, .typ = .f32 },
    },
    .params_ui = .{
        .{ .name = "wb_mode", .control = .{ .combo = .{ .items = .{ "cam mul", "cat", "vkdt" } } } },
        .{ .name = "wb_coeff", .control = .{ .sliders = .{ .n = 3, .min = 0.0, .max = 4.0, .labels = .{ "R", "G", "B" } } } },
    },
    .sockets = .{
        .{
            .name = "input",
            .type = .read,
            .format = .rgba16float,
            .color_profile = .{
                .white_point = .any,
                .primaries = .camera,
                // TODO: handle any trc and automagically linearize it
                .trc = .linear,
            },
        },
        .{
            .name = "output",
            .type = .write,
            .format = .rgba16float,
            .color_profile = .{
                .white_point = .d65,
                .primaries = .rec2020,
                .trc = .linear,
            },
        },
    },
}
